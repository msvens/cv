{
	"name": "cv",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=24",
		"pnpm": ">=11"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm check:svelte && pnpm lint && pnpm test && pnpm build",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:svelte:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "TZ=Europe/Stockholm vitest run",
		"test:watch": "TZ=Europe/Stockholm vitest",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:seed": "tsx scripts/seed.ts",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"better-auth": "^1.7.7",
		"drizzle-orm": "^0.45.3",
		"marked": "^18.0.14",
		"pdfmake": "^0.3.11",
		"postgres": "^3.4.9",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.19.0",
		"@types/pdfmake": "^0.3.3",
		"dotenv": "^18.0.4",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.1.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-hero-icons": "^5.2.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vitest": "^5.0.2"
	}
}
