# Variables the app reads are declared and validated in src/env.ts: a missing or invalid value
# fails both `pnpm build` and server start.

# Database
DATABASE_URL=postgres://resume:password@localhost:5432/resume

# Admin sign-in (Better Auth, GitHub OAuth). The GitHub OAuth app's callback URL is
# <BETTER_AUTH_URL>/api/auth/callback/github — the same path the old Next app used.
BETTER_AUTH_SECRET=                   # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3004 # the public origin in production
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=                      # numeric ID: curl -s https://api.github.com/users/YOUR_LOGIN | jq .id

# Production only (adapter-node). ORIGIN must be the public URL — SvelteKit's CSRF check
# rejects form-action POSTs whose Origin header doesn't match it.
# ORIGIN=https://cv.example.com
# PORT=3004
