# Database
DATABASE_URL=postgres://resume:password@localhost:5432/resume

# Production only (adapter-node). ORIGIN must be the public URL — SvelteKit's CSRF check
# rejects form-action POSTs whose Origin header doesn't match it.
# ORIGIN=https://cv.example.com
# PORT=3004

# Auth (GitHub OAuth via @auth/sveltekit) — wired up in phase 5, see MIGRATION.md.
# The callback path is kept at /api/auth/callback/github so the existing GitHub OAuth apps work.
AUTH_SECRET=                          # openssl rand -base64 32
AUTH_TRUST_HOST=true                  # required behind nginx
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_ID=                      # numeric ID — curl -s https://api.github.com/users/YOUR_USERNAME | jq .id
